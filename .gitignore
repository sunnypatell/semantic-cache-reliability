# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- LaTeX build artifacts (keep .tex, .bib, and final .pdf) ----
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.xdv
*.brf
*.nav
*.snm
*.vrb

# ---- Large data / model / result artifacts (regenerated by code) ----
data/raw/**
!data/raw/.gitkeep
*.faiss
*.index
*.npy
*.npz
*.pkl
*.parquet
.cache/
hf_cache/

# ---- build diagnostics + compiled main pdf (regenerable) ----
paper/_diag/
paper/main.pdf
paper/latexmk.run.txt
paper/*.o.txt
paper/*.e.txt

# ---- OS / editor ----
Thumbs.db
.DS_Store
*.swp
